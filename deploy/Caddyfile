# HTTPS automático: o Caddy pede e renova o certificado do domínio sozinho (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Sem www: quem digitar www.dominio vai para o endereço principal.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
