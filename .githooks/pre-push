#!/bin/sh
# Antes de cada push: testes das regras e da API (npm test, uns 10 segundos).
# Se algum falhar, o push é cancelado. Os testes de ponta a ponta (Playwright) ficam no GitHub.
# Numa emergência, para enviar mesmo assim: git push --no-verify
echo "==> pre-push: rodando npm test antes de enviar"
if ! npm test --silent; then
  echo ""
  echo "Testes falharam: push cancelado. Corrija e tente de novo."
  echo "(Para enviar mesmo assim, numa emergência: git push --no-verify)"
  exit 1
fi
