{
  "name": "vanellis-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "demo:export": "npm run demo:export -w server",
    "demo:build": "npm run build:demo -w client",
    "usuario:senha": "npm run usuario:senha -w server --",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
