# Copie para .env no servidor (cp .env.production.example .env) e preencha.
# O deploy/setup-server.sh já gera uma senha forte para o banco.

# Domínio do site, sem https:// (o painel fica em https://DOMINIO/painel/)
DOMAIN=vanellis.com.br

# E-mail para avisos do certificado HTTPS (Let's Encrypt)
ACME_EMAIL=contato@exemplo.com

# Senha do banco: só letras e números (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Backup diário: hora (00 a 23, horário de Brasília) e quantos dias guardar
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
